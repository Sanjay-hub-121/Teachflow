# Copy to .env locally or configure these values in the deployment provider.
# Never commit real credentials.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE
BETTER_AUTH_URL=https://your-production-domain.example
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
VITE_AUTH_ENABLED=true
# Public half of the Web Push VAPID key. Keep the private key server-only.
VITE_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=replace-with-a-long-random-cron-secret
